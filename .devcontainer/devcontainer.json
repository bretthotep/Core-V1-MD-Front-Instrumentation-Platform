{
  "name": "Core V1-MD",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    // Lightweight desktop reachable from the browser, so the PySide6 simulator window is visible.
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": { "label": "Simulator desktop (noVNC)", "onAutoForward": "notify" }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.cwd": "${workspaceFolder}/core-v1-md",
        "python.testing.pytestArgs": ["tests"],
        "terminal.integrated.cwd": "${workspaceFolder}/core-v1-md"
      },
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
